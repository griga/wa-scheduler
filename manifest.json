{
  "name": "Hello Extensions",
  "description": "Super simple Chrome extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html",
    "default_icon": "img/hi image.png"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "https://chromewebstore.google.com/*",
        "https://developer.chrome.com/docs/webstore/*"
      ]
    }
  ]
}