{
  "name": "WA Scheduled Messages",
  "description": "Schedule repeated WhatsApp group messages from a simple popup.",
  "version": "0.0.1",
  "manifest_version": 3,
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "img/logo-128.png"
  },
  "icons": {
    "16": "img/logo-016.png",
    "32": "img/logo-032.png",
    "48": "img/logo-048.png",
    "128": "img/logo-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://web.whatsapp.com/*"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["main-world-spoof.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
